<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="S3 Source Configuration">
        <f:entry title="Directory / Prefix" field="prefix">
            <f:textbox class="jenkins-input"/>
        </f:entry>
        <f:entry title="Target directory" field="targetDirectory">
            <f:textbox class="jenkins-input" placeholder="(workspace root)"/>
        </f:entry>
    </f:section>
</j:jelly>
