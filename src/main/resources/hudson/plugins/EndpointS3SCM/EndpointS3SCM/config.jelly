<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core"
         xmlns:f="/lib/form">

    <f:entry title="Endpoint" field="endpoint">
        <f:textbox/>
    </f:entry>

    <f:entry title="Bucket" field="bucket">
        <f:textbox/>
    </f:entry>

    <f:entry title="Object key (path)" field="key">
        <f:textbox/>
    </f:entry>

    <f:entry title="Region" field="region">
        <f:textbox/>
    </f:entry>

    <f:entry title="Credentials" field="credentialsId">
        <f:select/>
    </f:entry>

    <f:entry title="Strip top-level directory" field="stripTopLevelDir">
        <f:checkbox default="true" checked="${instance != null ? instance.stripTopLevelDir : true}"/>
    </f:entry>

    <f:entry title="Max retries" field="maxRetries">
        <f:number default="3"/>
    </f:entry>

    <f:entry title="Retry delay (ms)" field="retryDelayMs">
        <f:number default="1000"/>
    </f:entry>

    <f:entry title="Test connection">
        <f:validateButton
                title="Test connection"
                progress="Testing..."
                method="testConnection"
                with="endpoint,bucket,key,credentialsId,region"/>
    </f:entry>
</j:jelly>